#!name = 百度贴吧去广告
#!desc = v0.2：移除推荐流整张广告卡片；关闭首页/帖子/评论广告位与第三方广告 SDK，移除标记为广告的浮动入口。开屏已获用户验证，其余需真机复测。需开启脚本与 MitM 并信任证书。
#!author = zhuchen458
#!homepage = https://github.com/zhuchen458/bdtbads-loon
#!date = 2026-10-27
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,贴吧

[Script]
response if ${url} ~= /^https:\/\/tiebac\.baidu\.com\/c\/(?:f\/ad\/getSplashAd|s\/sync)(?:[?#]|$)/ then script("https://raw.githubusercontent.com/zhuchen458/bdtbads-loon/main/scripts/tieba-json.js?v=20261027-2") with requires_body=true, timeout=10, tag="贴吧开屏与广告配置 v0.2"
response if ${url} ~= /^https:\/\/tiebac\.baidu\.com\/c\/(?:f\/ad\/getFeedAd|b\/ad\/adBid|f\/excellent\/personalized|f\/pb\/page)(?:[?#]|$)/ then script("https://raw.githubusercontent.com/zhuchen458/bdtbads-loon/main/scripts/tieba-protobuf.js?v=20261027-2") with requires_body=true, binary_body_mode=true, timeout=10, tag="贴吧广告整卡移除 v0.2"

[Mitm]
hostname = tiebac.baidu.com
